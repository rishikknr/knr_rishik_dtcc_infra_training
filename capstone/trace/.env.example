# PostgreSQL container administrator; never the backend runtime identity.
POSTGRES_PASSWORD=replace-with-a-strong-admin-secret
# Distinct secrets; export in the shell running psql/backend (Compose .env is not
# automatically loaded by Maven). Provision roles as described in docs/tenancy.md.
TRACE_MIGRATION_PASSWORD=replace-with-a-strong-migration-secret
TRACE_RUNTIME_PASSWORD=replace-with-a-different-strong-runtime-secret
TRACE_PROCESSOR_URL=http://127.0.0.1:8000
# Local development delivery is optional; authentication is always required.
TRACE_LOCAL_TOKEN_DELIVERY=false
# Set true with HTTPS; leave false only for loopback HTTP development.
TRACE_SECURE_COOKIES=false
TRACE_SESSION_TIMEOUT=30m
# Used only with the exclusive loopback local-dev profile; production signup stays disabled.
TRACE_LOCAL_SIGNUP_ENABLED=true
# Generate privately; backend only. Empty disables credential storage/live operations.
TRACE_CONNECTOR_ENCRYPTION_KEY=
# Same private random token in backend and processor; required for /internal/*.
TRACE_PROCESSOR_TOKEN=
